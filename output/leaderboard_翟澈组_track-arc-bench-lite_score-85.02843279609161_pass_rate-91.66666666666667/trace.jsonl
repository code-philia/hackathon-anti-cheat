or os.getenv(\"OPENAI_BASE_URL\") or \"https://api.openai.com/v1\"\r\n58:        if not api_key:\r\n59:            raise ValueError(\"Set VISUAL_API_KEY or OPENAI_API_KEY in compiler/.env; the model must accept images\")\r\n60:        self.reasoning = os.getenv(\"VISUAL_REASONING\", os.getenv(\"MODEL_REASONING\", \"low\")).lower()\r\n61:        if self.reasoning not in {\"auto\", \"provider\", \"none\", \"low\", \"high\", \"max\"}:\r\n62:            raise ValueError(\"VISUAL_REASONING must be auto, provider, none, low, high or max\")\r\n63:        self._reasoning_supported = True\r\n64:        self.client = OpenAI(api_key=api_key, base_url=base_url, timeout=600, max_retries=2, http_client=http_client())\r\n65:\r\n66:    def analyze(self, image: Path, max_attempts: int = 10) -> dict:\r\n67:        \"\"\"Send one supported reference image and parse the returned layout, elements, and style evidence.\"\"\"\r\n68:        mime = mimetypes.guess_type(image.name)[0]\r\n69:        if mime not in {\"image/png\", \"image/jpeg\", \"image/webp\", \"image/gif\"}:\r\n70:            raise ValueError(f\"Unsupported image format: {image.name}\")\r\n71:        original = image.read_bytes()\r\n72:        compressed, mime = compress_image(original, mime)\r\n73:        print(f\"Image compression: {image.name} | {len(original) / 1024:.1f} -> {len(compressed) / 1024:.1f} KiB\", flush=True)\r\n74:        encoded = base64.b64encode(compressed).decode(\"ascii\")\r\n75:        result, _ = propose_json(self, VISION_INSTRUCTIONS, {\"image_url\": f\"data:{mime};base64,{encoded}\"},\r\n","exit_code":0,"status":"completed"}}
