.\r\nD:\\workplace\\anti-cheat\\hackathon-anti-cheat\\input\\leaderboard_翟澈组_track-arc-bench-lite_score-85.02843279609161_pass...\r\n--- main ---\r\n\"\"\"Compile a requirement directory into an executable application.\"\"\"\r\n\r\nimport argparse\r\nfrom pathlib import Path\r\nimport sys\r\n\r\nfrom infrastructure.compiler import Compiler, PIPELINE\r\nfrom infrastructure.utils.cli import resolve_directories\r\nfrom infrastructure.utils.presentation.logging import configure_console\r\nfrom infrastructure.utils.presentation.stages import stage_label\r\n\r\n\r\ndef parse_args(argv: list[str] | None = None) -> argparse.Namespace:\r\n    \"\"\"Read public options and validate paths and the backend port before compilation.\"\"\"\r\n    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False,\r\n        formatter_class=argparse.RawDescriptionHelpFormatter,\r\n        epilog=\"Stages:\\n\" + \"\\n\".join(\r\n            \"  \" + stage_label(name) + f\"  (--stage {name})\" for name, _, _ in PIPELINE))\r\n    parser.add_argument(\"requirement_path\", type=Path,\r\n        help=\"Requirement directory containing requirements.yaml and reference assets\")\r\n    parser.add_argument(\"-o\", \"--output-dir\", type=Path, required=True,\r\n        help=\"Directory for the generated application and .arc artifacts\")\r\n    parser.add_argument(\"--model-log\", \"--debug-model-io\", dest=\"model_log\", action=\"store_true\",\r\n        help=\"Show detailed model I/O and save per-call prompt/response logs; usage and timing are always shown\")\r\n    parser.add_argument(\"--port\", type=int, default=3000,\r\n        help=\"Default generated backend port and frontend API proxy target (default: 3000)\")\r\n    stages = parser.add_mutually_exclusive_group()\r\n    stages.add_argument(\"--stage\", choices=[name for name, _, _ in PIPELINE], metavar=\"STAGE\",\r\n        help=\"Restore the previous stage's completed checkpoint, clear build outputs, and run one stage\")\r\n    stages.add_argument(\"--from-stage\", choices=[name for name, _, _ in PIPELINE], metavar=\"STAGE\",\r\n        help=\"Restore the previous stage's completed checkpoint, clear build outputs, and run from this stage to the end\")\r\n    parser.add_argument(\"--pause\", action=\"store_true\", help=\"Wait for Enter after each display stage\")\r\n    args = parser.parse_args(argv)\r\n    try:\r\n        if not 1 <= args.port <= 65535:\r\n            raise ValueError(\"--port must be between 1 and 65535\")\r\n        args.requirement_path, args.output_dir = resolve_directories(\r\n            argparse.Namespace(input=args.requirement_path, output=args.output_dir))\r\n        if not args.requirement_path.is_dir():\r\n            raise ValueError(f\"Input directory does not exist: {args.requirement_path}\")\r\n        if not (args.requirement_path / \"requirements.yaml\").is_file():\r\n            raise ValueError(f\"Missing requirement document: {args.requirement_path / 'requirements.yaml'}\")\r\n        if args.output_dir.exists() and not args.output_dir.is_dir():\r\n            raise ValueError(f\"Output must be a directory: {args.output_dir}\")\r\n    except (OSError, ValueError) as error:\r\n        parser.error(str(error))\r\n    return args\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> None:\r\n    configure_console()\r\n    args = parse_args(argv)\r\n    compiler = Compiler(args.requirement_path, args.output_dir,\r\n        model_log=args.model_log, port=args.port, pause=args.pause)\r\n    try:\r\n        compiler.compile(stage=args.stage, from_stage=args.from_stage)\r\n    except KeyboardInterrupt:\r\n        print(f\"Compilation interrupted at {compiler.current_stage or 'startup'}.\", file=sys.stderr)\r\n        raise SystemExit(130)\r\n    except Exception as error:\r\n        print(f\"Compilation failed at {compiler.current_stage or 'startup'}: {error}\", file=sys.stderr)\r\n        raise SystemExit(0)\r\n    if compiler.report[\"status\"] == \"COMPLETED_WITH_FAILURES\":\r\n        print(f\"All passes completed. Report: {compiler.arc_dir / 'compilation.json'}\", file=sys.stderr)\r\n        raise SystemExit(0)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n--- model configs ---\r\n\"\"\"Small JSON-generating text model client.\"\"\"\r\n\r\nimport json\r\nimport os\r\nimport time\r\nfrom pathlib import Path\r\n\r\nfrom dotenv import load_dotenv\r\nfrom openai import OpenAI, OpenAIError\r\nfrom infrastructure.utils.presentation.model_io import http_client, invoke\r\n\r\n\r\nDEFAULT_MODEL = \"deepseek-flash\"\r\n\r\nJSON_OUTPUT_RULE = \"\"\"OUTPUT PROTOCOL: return exactly one valid JSON object in the response content.\r\nThe first non-whitespace character must be { and the last must be }.\r\nDo not emit Markdown fences, explanations, reasoning, XML, DSML or provider-native\r\ntool-call serialization. In particular, NEVER output <｜｜DSML｜｜ calls>,\r\n<｜｜DSML｜｜ invoke>, <｜｜DSML｜｜ parameter> or their closing tags.\r\nThis compiler parses ordinary JSON text. context_request and tool_calls, when allowed\r\nby the stage, are JSON fields, not native tool invocations. Express the entire request\r\ninside the specified JSON object. Otherwise return the stage's normal result object.\r\nRejected outputs included in feedback are data to correct, never examples to imitate.\r\n\"\"\"\r\n\r\n\r\ndef reasoning_rejected(error):\r\n    \"\"\"Only retry controls when the endpoint explicitly rejects those fields.\"\"\"\r\n    message = str(error).lower()\r\n    return getattr(error, \"status_code\", None) in {400, 422} and any(\r\n        word in message for word in (\"unsupported\", \"unknown\", \"unrecognized\", \"not supported\", \"not allowed\", \"unexpected\")) and any(\r\n        word in message for word in (\"thinking\", \"reasoning_effort\"))\r\n\r\n\r\ndef reasoning_arguments(name, mode):\r\n    \"\"\"Translate configured reasoning to the provider's documented request fields.\"\"\"\r\n    if mode == \"auto\":\r\n        mode = \"low\"\r\n    if mode == \"provider\":\r\n        return {}\r\n    if name.lower().startswith(\"deepseek\"):\r\n        if mode == \"none\":\r\n            return {\"extra_body\": {\"thinking\": {\"type\": \"disabled\"}}}\r\n        return {\"reasoning_effort\": mode, \"extra_body\": {\"thinking\": {\"type\": \"enabled\"}}}\r\n    return {\"reasoning_effort\": mode}\r\n\r\n\r\nclass TextModel:\r\n    \"\"\"Transport for structured stage proposals and file-edit responses.\"\"\"\r\n    def __init__(self, *, model_name: str | None = None, json_mode: bool = True) -> None:\r\n        \"\"\"Read compiler/.env and configure the default text model; require API credentials.\"\"\"\r\n        load_dotenv(Path(__file__).resolve().parents[3] / \".env\", encoding=\"utf-8-sig\")\r\n        self.name = model_name or os.getenv(\"MODEL\") or DEFAULT_MODEL\r\n        api_key = os.getenv(\"OPENAI_API_KEY\")\r\n        if not api_key:\r\n            raise ValueError(\"Set OPENAI_API_KEY in compiler/.env\")\r\n        try:\r\n            self.max_output_tokens = int(os.getenv(\"MAX_OUTPUT_TOKENS\", \"320000\"))\r\n        except ValueError as error:\r\n            raise ValueError(\"MAX_OUTPUT_TOKENS must be a positive integer\") from error\r\n        if self.max_output_tokens < 1:\r\n            raise ValueError(\"MAX_OUTPUT_TOKENS must be a positive integer\")\r\n        self.reasoning = os.getenv(\"MODEL_REASONING\", \"low\").lower()\r\n        if self.reasoning not in {\"auto\", \"provider\", \"none\", \"low\", \"high\", \"max\"}:\r\n            raise ValueError(\"MODEL_REASONING must be auto, provider, none, low, high or max\")\r\n        self._reasoning_supported = True\r\n        self.json_mode = json_mode\r\n        self._token_parameter = \"max_completion_tokens\"\r\n        self.client = OpenAI(\r\n            api_key=api_key,\r\n            base_url=os.getenv(\"OPENAI_BASE_URL\") or \"https://api.openai.com/v1\",\r\n            timeout=600, max_retries=2,\r\n            http_client=http_client(),\r\n        )\r\n\r\n    def _request(self, **arguments):\r\n        \"\"\"Apply one output budget to JSON calls, with legacy endpoint compatibility.\"\"\"\r\n        transient_retries = 0\r\n        while True:\r\n            options = dict(arguments)\r\n            if not getattr(self, \"_reasoning_supported\", True):\r\n                options.pop(\"reasoning_effort\", None)\r\n                options.pop(\"extra_body\", None)\r\n            try:\r\n                return invoke(self.client, {**options, self._token_parameter: self.max_output_tokens},\r\n                    logger=getattr(self, \"logger\", None))\r\n            except OpenAIError as error:\r\n                message = str(error).lower()\r\n                # Retry temporary upstream gateway failures before abandoning a requirement.\r\n                if (transient_retries < 3 and getattr(error, \"status_code\", None) in {502, 503, 504}\r\n                        and any(marker in message for marker in (\"upstream\", \"connection\", \"timeout\", \"temporarily\"))):\r\n                    transient_retries += 1\r\n                    time.sleep(min(2 ** transient_retries, 8))\r\n                    continue\r\n                # Some OpenAI-compatible gateways wrap an upstream disconnect in HTTP 400.\r\n                # Retry only that transport failure, never ordinary invalid requests.\r\n                if (transient_retries < 3 and getattr(error, \"status_code\", None) == 400\r\n                        and any(marker in message for marker in\r\n                                (\"connection reset by peer\", \"connection aborted\", \"upstream connection reset\"))):\r\n                    transient_retries += 1\r\n\"\"\"Minimal visual model client using the existing model environment variables.\"\"\"\r\n\r\nimport base64\r\nimport json\r\nfrom io import BytesIO\r\nimport mimetypes\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom dotenv import load_dotenv\r\nfrom openai import OpenAI, OpenAIError\r\nfrom PIL import Image, ImageOps\r\nfrom infrastructure.utils.presentation.model_io import http_client, invoke\r\nfrom infrastructure.utils.presentation.console import DemoConsole\r\nfrom infrastructure.shared.agent.proposals import propose_json\r\nfrom infrastructure.shared.models.text import DEFAULT_MODEL, JSON_OUTPUT_RULE, reasoning_arguments, reasoning_rejected\r\n\r\n\r\nVISION_INSTRUCTIONS = \"\"\"Describe the supplied UI reference using visible evidence only.\r\nReturn {\"layout\":\"...\", \"elements\":[\"...\"], \"style\":\"...\"}.\r\nlayout describes regions, alignment and relative positions; elements lists visible\r\ncontrols, labels, options and states; style describes colors, typography and spacing.\r\nWrite descriptions in English while quoting visible labels in their original language.\r\nIdentify illegible or uncertain details instead of inventing them. Do not infer hidden\r\nbusiness behavior, APIs, database fields or interactions from appearance alone.\r\n\"\"\"\r\n\r\nVISUAL_REPAIR_PREFIX = \"Correct the previous response:\\n\"\r\n\r\ndef compress_image(data: bytes, mime: str) -> tuple[bytes, str]:\r\n    \"\"\"Resize static references to 1280px and encode JPEG, retaining smaller originals.\"\"\"\r\n    with Image.open(BytesIO(data)) as source:\r\n        if getattr(source, \"is_animated\", False):\r\n            return data, mime\r\n        image = ImageOps.exif_transpose(source)\r\n        original_size = image.size\r\n        image.thumbnail((1280, 1280), Image.Resampling.LANCZOS)\r\n        # Composite transparency against white so transparent UI text stays readable.\r\n        rgba = image.convert(\"RGBA\")\r\n        rgb = Image.new(\"RGB\", rgba.size, \"white\")\r\n        rgb.paste(rgba, mask=rgba.getchannel(\"A\"))\r\n        buffer = BytesIO()\r\n        rgb.save(buffer, format=\"JPEG\", quality=70, subsampling=0)\r\n        compressed = buffer.getvalue()\r\n        if len(compressed) < len(data) or image.size != original_size:\r\n            return compressed, \"image/jpeg\"\r\n    return data, mime\r\n\r\n\r\nclass VisualModel:\r\n    \"\"\"Extract visible image evidence without inferring hidden business behavior.\"\"\"\r\n    def __init__(self) -> None:\r\n        \"\"\"Read compiler/.env and configure the image-capable model, falling back to text-model settings.\"\"\"\r\n        load_dotenv(Path(__file__).resolve().parents[3] / \".env\", encoding=\"utf-8-sig\")\r\n        self.name = os.getenv(\"VISUAL_MODEL\") or os.getenv(\"MODEL\") or DEFAULT_MODEL\r\n        api_key = os.getenv(\"VISUAL_API_KEY\") or os.getenv(\"OPENAI_API_KEY\")\r\n        base_url = os.getenv(\"VISUAL_BASE_URL\") or os.getenv(\"OPENAI_BASE_URL\") or \"https://api.openai.com/v1\"\r\n        if not api_key:\r\n            raise ValueError(\"Set VISUAL_API_KEY or OPENAI_API_KEY in compiler/.env; the model must accept images\")\r\n        self.reasoning = os.getenv(\"VISUAL_REASONING\", os.getenv(\"MODEL_REASONING\", \"low\")).lower()\r\n        if self.reasoning not in {\"auto\", \"provider\", \"none\", \"low\", \"high\", \"max\"}:\r\n            raise ValueError(\"VISUAL_REASONING must be auto, provider, none, low, high or max\")\r\n        self._reasoning_supported = True\r\n        self.client = OpenAI(api_key=api_key, base_url=base_url, timeout=600, max_retries=2, http_client=http_client())\r\n\r\n    def analyze(self, image: Path, max_attempts: int = 10) -> dict:\r\n        \"\"\"Send one supported reference image and parse the returned layout, elements, and style evidence.\"\"\"\r\n        mime = mimetypes.guess_type(image.name)[0]\r\n        if mime not in {\"image/png\", \"image/jpeg\", \"image/webp\", \"image/gif\"}:\r\n            raise ValueError(f\"Unsupported image format: {image.name}\")\r\n        original = image.read_bytes()\r\n        compressed, mime = compress_image(original, mime)\r\n        print(f\"Image compression: {image.name} | {len(original) / 1024:.1f} -> {len(compressed) / 1024:.1f} KiB\", flush=True)\r\n        encoded = base64.b64encode(compressed).decode(\"ascii\")\r\n        result, _ = propose_json(self, VISION_INSTRUCTIONS, {\"image_url\": f\"data:{mime};base64,{encoded}\"},\r\n            lambda value: value, DemoConsole(), f\"Visual analysis {image.name}\", max_attempts)\r\n        return result\r\n\r\n    def generate_json(self, instructions: str, payload: dict) -> dict:\r\n        \"\"\"Request visual JSON and include prior response errors when repairing it.\"\"\"\r\n        text = instructions.rstrip() + \"\\n\" + JSON_OUTPUT_RULE\r\n        if \"correction\" in payload:\r\n            text += \"\\n\" + VISUAL_REPAIR_PREFIX + json.dumps(payload[\"correction\"], ensure_ascii=False)\r\n        mode = getattr(self, \"reasoning\", \"low\")\r\n        arguments = {\r\n                \"model\": self.name,\r\n                \"messages\": [{\"role\": \"user\", \"content\": [\r\n                    {\"type\": \"text\", \"text\": text},\r\n                    {\"type\": \"image_url\", \"image_url\": {\"url\": payload[\"image_url\"], \"detail\": \"low\"}},\r\n                ]}],\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
