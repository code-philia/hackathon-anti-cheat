     def _safe(self, what: str, fn, *args, **kwargs) -> Any:\r\n57:         if self.runtime is None:\r\n58:             return None\r\n59:         try:\r\n60:             return fn(*args, **kwargs)\r\n61:         except Exception:\r\n62:             _warn(what)\r\n63:             return None\r\n64: \r\n65:     def start(self, requirement_tree: dict | None) -> None:\r\n66:         rt = self.runtime\r\n67:         if rt is None:\r\n68:             return\r\n69:         self._safe('git 初始化', rt.git.ensure_repo, create_initial_commit=True)\r\n70:         self._safe('traceability 初始化', rt.traceability.init_db)\r\n71:         if requirement_tree:\r\n72:             _tree_ids(requirement_tree, self.known_ids)\r\n73:             self._safe('写入需求树', rt.traceability.store_requirement_tree, requirement_tree)\r\n74:         self._safe('run-started', rt.events.mark_run_started, 'Agent started')\r\n75: \r\n76:     def report(self, items: list[dict], message: str = '', *, commit: bool = True) -> str:\r\n77:         rt = self.runtime\r\n78:         if rt is None:\r\n79:             return 'SDK 不可用，已跳过'\r\n80:         done = []\r\n81:         for item in items:\r\n82:             req_id = str(item.get('req_id') or '').strip()\r\n83:             state = str(item.get('state') or '').strip().lower()\r\n84:             method = _STATES.get(state)\r\n85:             if not req_id or method is None:\r\n86:                 continue\r\n87:             self._safe(f'{req_id} {state}', getattr(rt.events, method), req_id, item.get('note'))\r\n88:             done.append(f'{req_id}:{state}')\r\n89:         if done and commit:\r\n90:             title = message.strip() or ', '.join(done[:5])\r\n91:             self._safe('git commit', rt.git.commit, f'{title}'[:200])\r\n92:         return f'已记录 {len(done)} 项：{\", \".join(done)}' if done else '没有有效条目'\r\n93: \r\n94:     def finish(self, ok: bool, message: str) -> None:\r\n95:         rt = self.runtime\r\n96:         if rt is None:\r\n97:          