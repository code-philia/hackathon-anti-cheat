tools.write_tools import WriteFileTool\r\n42: from model_sources import StaticModelSource, set_default_model_source_store\r\n43: from prompt.lilliv3_code_prompt import Lilliv3CodePrompt\r\n44: from tools.shell_tools import kill_all_async\r\n45: from tools.skill_tools import BundledSkills, LoadBundledSkillTool\r\n46: \r\n47: DEFAULT_WEB_PORT = 3000\r\n48: DEFAULT_MAX_ROUNDS = 500\r\n49: # �����ı�������������Ϣ�����ޣ��������ļ�ֻ��·������ Agent �Լ���ȡ\r\n50: INLINE_FILE_MAX_BYTES = 200_000\r\n51: INLINE_TOTAL_MAX_CHARS = 200_000\r\n52: # �������ͨ�ó���Լ�������ż������ٳ�������ô����ڵ㡢�Ҳ����ڴ������ڵ�� 1/4\r\n53: COMMON_SENTENCE_MIN_NODES = 3\r\n54: \r\n55: _SENTENCE_BREAK = re.compile(r'(?<=[.!?])\\s+(?=[A-Z\"��`(])')\r\n56: _BACKTICKED = re.compile(r'`([^`]+)`')\r\n57: \r\n58: \r\n59: class ArcBenchPrompt(Lilliv3CodePrompt):\r\n60:     # �ύ������ markitdown����ͼ / ��ͼ����ļ�д������Ŀ¼�����⻷��Ҳ����Ҫ\r\n61:     enable_document_conversion = False\r\n62:     enable_read_image = False\r\n63:     enable_image_generation = False\r\n64: \r\n65:     def __init__(self, reporter: ArcReporter | None = None) -> None:\r\n66:         # ���� Skills��<��Ŀ��>/skills����Ŀ¼��� system�������� load_skill ��������\r\n67:         skills = BundledSkills()\r\n68:         block = skills.catalog_block()\r\n69:         if block:\r\n70:             self.tools = [*self.tools, LoadBundledSkillTool(skills)]\r\n71:             self.runtime_context_blocks = [block]\r\n72:         # ���⻷������ֵ�أ�write_file ���Ѵ����ļ�ֱ�Ӹ�д��������ȱ overwrite=true �����˷�һ��\r\n73:         for tool in self.tools:\r\n74:             if isinstance(tool, WriteFileTool):\r\n75:                 tool.implicit_overwrite = True\r\n76:         if reporter is not None:\r\n77:             self.tools = [\r\n78:                 ArcTodoTool(reporter) if isinstance(tool, TodoTool)\r\n79:                 else ArcShellExecTool(reporter) if isinstance(tool, ShellExecTool)\r\n80:                 else tool\r\n81:                 for tool in self.tools\r\n82:             ]\r\n83:             self.tools = [*self.tools, ArcReportTool(reporter)]\r\n84: \r\n85: \r\n86: def parse_args(argv: list[str] | None = None) -> argparse.Namespace:\r\n87:     parser = argparse.ArgumentParser(description='Lilliv3 Code �� ARC-Bench ���')\r\n88:     parser.add_argument('requirement_path', nargs='?', help='����Ŀ¼���ļ���ȱʡ�� ARCBENCH_TASK_DIR��')\r\n89:     parser.add_argument('--output-dir', required=True, help='������Ŀ�����Ŀ¼')\r\n90:     parser.add_argument('--type', default='web', help='�������ͣ�Ĭ�� web')\r\n91:     parser.add_argument('--web-port', type=int, help='����Ӧ��ʹ�õĶ˿ڣ�ȱʡ�� ARCBENCH_WEB_PORT��')\r\n92:     local = parser.add_argument_group('���ص��ԣ�ƽ̨���ᴫ�룩')\r\n93:     local.add_argument('--model', help='ʹ�ñ��� model_sources.db �еǼǵ�ģ�� ID')\r\n94:     local.add_argument('--max-rounds', type=int, default=DEFAULT_MAX_ROUNDS, help='ģ��������������')\r\n95:     local.add_argument('--time-limit', type=float, help='����ʱ�����ޣ��룩')\r\n96:     local.add_argument('--effort', default='high', choices=['fast', 'turbo', 'high', 'max', 'ultra'])\r\n97:     return parser.parse_args(argv)\r\n98: \r\n99: \r\n100: def configure_model(args: argparse.Namespace) -> tuple[str, str]:\r\n101:     \"\"\"���أ�ģ�� ID, ��־�õ���Դ��������ȱ����ʱ�� ValueError��\"\"\"\r\n102:     if args.model:\r\n103:         return args.model, 'model_sources.db'\r\n104:     api_key = os.getenv('OPENAI_API_KEY') or os.getenv('ARCBENCH_API_KEY')\r\n105:     model = os.getenv('MODEL')\r\n106:     base_url = os.getenv('OPENAI_BASE_URL') or 'https://api.openai.com/v1'\r\n107:     if not api_key or not model:\r\n108:         raise ValueError('ȱ��ģ�����ã���Ҫ�������� OPENAI_API_KEY���� ARCBENCH_API_KEY���� MODEL')\r\n109:     set_default_model_source_store(StaticModelSource.openai_compatible(model, base_url, api_key))\r\n110:     return model, urlparse(base_url).netloc or base_url\r\n111: \r\n112: \r\n113: def _read_text(path: Path) -> str | None:\r\n114:     \"\"\"С���ı��ļ��������ݣ������ƻ���󷵻� None��\"\"\"\r\n115:     if path.stat().st_size > INLINE_FILE_MAX_BYTES:\r\n116:         return None\r\n117:     data = path.read_bytes()\r\n118:     if b'\\x00' in data[:8192]:\r\n119:         return None\r\n120:     for encoding in ('utf-8-sig', 'gb18030'):\r\n121:         try:\r\n122:             return data.decode(encoding)\r\n123:         except UnicodeDecodeError:\r\n124:             continue\r\n125:     return data.decode('utf-8', errors='replace')\r\n126: \r\n127: \r\n128: def load_requirement_tree(path: Path) -> dict | None:\r\n129:     \"\"\"ARC-Bench �� requirements.yaml��id / name / type / description / children / scenarios ��ɵ�����\r\n130: \r\n131:     �������ֽṹ�����޷�������ʱ���� None���ɵ��÷�����ͨ�ı�������\r\n132:     \"\"\"\r\n133:     if yaml is None or path.suffix.lower() not in ('.yaml', '.yml'):\r\n134:         return None\r\n135:     try:\r\n136:         root = yaml.safe_load(path.read_text(encoding='utf-8-sig'))\r\n137:     except (yaml.YAMLError, UnicodeDecodeError):\r\n138:         return None\r\n139:     if isinstance(root, dict) and 'id' in root and ('children' in root or 'scenarios' in root):\r\n140:         return root\r\n141:     return None\r\n142: \r\n143: \r\n144: def find_requirement_tree(path: Path) -> dict | None:\r\n145:     files = [path] if path.is_file() else sorted(p for p in path.rglob('*') if p.is_file())\r\n146:     for file in files:\r\n147:         tree = load_requirement_tree(file)\r\n148:         if tree is not None:\r\n149:             return tree\r\n150:     return None\r\n151: \r\n152: \r\n153: def _sentences(text) -> list[str]:\r\n154:     return [s for s in _SENTENCE_BREAK.split(' '.join(str(text or '').split())) if s]\r\n155: \r\n156: \r\n157: def _steps(node: dict):\r\n158:     \"\"\"������� (�ؼ���, �����б�)���ṹ��������ֱ��������\"\"\"\r\n159:     for scenario in node.get('scenarios') or []:\r\n160:         if not isinstance(scenario, dict):\r\n161:             continue\r\n162:         for step in scenario.get('steps') or []:\r\n163:             if isinstance(step, dict):\r\n164:                 yield str(step.get('keyword') or '').strip().upper(), _sentences(step.get('content'))\r\n165: \r\n166: \r\n167: def digest_requirement_tree(root: dict, budget: int) -> str:\r\n168:     \"\"\"�������������ɽ��յ� Markdown��description ԭ����¼���������谴��ȥ�ء�\r\n169: \r\n170:     ԭʼ YAML �ĳ�����ģ�廯���ɵģ�ÿһ�����ظ�����������ͨ��ǰ�ᣬ�����\r\n171:     description ����������������������������������еľ��Ӹ�ֻ��һ�Σ�\r\n172:     �ڵ���ֻ���������еĲ��衣���� budget ʱ���ڵ�ضϲ�˵�����ĸ��ڵ���δ������\r\n173:     \"\"\"\r\n174:     nodes: list[tuple[int, dict]] = []\r\n175: \r\n176:     def walk(node: dict, depth: int) -> None:\r\n177:         nodes.append((depth, node))\r\n178:         for child in node.get('children') or []:\r\n179:             if isinstance(child, dict):\r\n180:                 walk(child, depth + 1)\r\n181: \r\n182:     walk(root, 0)\r\n183: \r\n184:     # �������ݣ�GIVEN ���ᵽ seed �ľ��ӡ�ͬһ�鷴����ȡֵ��ͬһ������\r\n185:     # ����ͬ�����ǲ�ͬ�������ֹ���ÿ�ִ�������в����ﶼ�ᱻ�滻�ɱ��\r\n186:     seed_first: dict = {}          # ȡֵ���� -> (���, �״γ��ֵľ���)\r\n187:     seed_label: dict[str, str] = {}  # ����ԭ�� -> ���\r\n188:     for _, node in nodes:\r\n189:         for keyword, sentences in _steps(node):\r\n190:             if keyword != 'GIVEN':\r\n191:                 continue\r\n192:             for s in sentences:\r\n193:                 if 'seed' in s.lower() and s not in seed_label:\r\n194:                     key = frozenset(_BACKTICKED.findall(s)) or s\r\n195:                     label = seed_first.setdefault(key, (f'S{len(seed_first) + 1}', s))[0]\r\n196:                     seed_label[s] = label\r\n197: \r\n198:     # ÿ���ڵ�ȥ�غ�Ĳ��裻ͳ��ÿ�����ӳ����ڶ��ٸ��ڵ���\r\n199:     per_node: dict[int, list[tuple[str, list[str], list[str]]]] = {}\r\n200:     node_count: dict[str, int] = {}\r\n201:     for index, (_, node) in enumerate(nodes):\r\n202:         steps, seen = [], set()\r\n203:         for keyword, sentences in _steps(node):\r\n204:             seeds = [seed_label[s] for s in sentences if s in seed_label]\r\n205:             fresh = [s for s in sentences if s not in seed_label and s not in seen]\r\n206:             seen.update(fresh)\r\n207:             steps.append((keyword, fresh, seeds))\r\n208:         if steps:\r\n209:             per_node[index] = steps\r\n210:             for s in seen:\r\n211:                 node_count[s] = node_count.get(s, 0) + 1\r\n212:     threshold = max(COMMON_SENTENCE_MIN_NODES, -(-len(per_node) // 4))\r\n213:     common: dict[str, str] = {}  # ���� -> �״γ���ʱ�Ĺؼ��֣�������˳��\r\n214:     for steps in per_node.values():\r\n215:         for keyword, fresh, _ in steps:\r\n216:             for s in fresh:\r\n217:                 if node_count[s] >= threshold:\r\n218:                     common.setdefault(s, keyword)\r\n219: \r\n220:     blocks: list[tuple[str | None, str]] = []\r\n221:     for index, (depth, node) in enumerate(nodes):\r\n222:         meta = str(node.get('type') or '')\r\n223:         deps = [str(d) for d in node.get('dependencies') or []]\r\n224:         if deps:\r\n225:             meta += ('��' if meta else '') + '���� ' + '��'.join(deps)\r\n226:         lines = [f'{\"#\" * min(4 + depth, 6)} {node.get(\"id\", \"\")} {node.get(\"name\", \"\")}'\r\n227:                  + (f'��{meta}��' if meta else '')]\r\n228:         description = str(node.get('description') or '').strip()\r\n229:         if description:\r\n230:             lines.append(description)\r\n231:         steps = per_node.get(index)\r\n232:         if steps:\r\n233:             used_seeds, bullets = [], []\r\n234:             for keyword, fresh, seeds in steps:\r\n235:                 for label in seeds:\r\n236:                     if label not in used_seeds:\r\n237:                         used_seeds.append(label)\r\n238:                 kept = [s for s in fresh if s not in common]\r\n239:                 if kept:\r\n240:                     bullets.append(f'- {keyword}: {\" \".join(kept)}')\r\n241:             seed_note = f'������ {\"��\".join(used_seeds)}��' if used_seeds else ''\r\n242:             if bullets:\r\n243:                 lines += [f'����Ҫ��{seed_note}��', *bullets]\r\n244:             elif seed_note:\r\n245:                 lines.append(f'�������ӣ�{\"��\".join(used_seeds)}')\r\n246:         blocks.append((str(node.get('id', '')), '\\n'.join(lines)))\r\n247: \r\n248:         if index == 0:  # ���ڵ������֮���ȸ�ȫ�ֵ�����������ͨ�ó���Լ��\r\n249:             if seed_first:\r\n250:                 blocks.append((None, '\\n'.join([\r\n251:                     '**��������**������ GIVEN ������ǰ�����ݣ����⿪ʼʱ��Щ��¼�����Ѿ����ڣ���Ӧ���Լ�Ԥ�ã�',\r\n252:                     *(f'- {label}��{text}' for label, text in seed_first.values()),\r\n253:                 ])))\r\n254:             if common:\r\n255:                 blocks.append((None, '\\n'.join([\r\n256:                     f'**ͨ�ó���Լ��**������ {threshold} ������ĳ�����������Щ���裬���Ĳ����ظ���',\r\n257:                     *(f'- {keyword}: {s}' for s, keyword in common.items()),\r\n258:                 ])))\r\n259: \r\n260:     leaves = sum(1 for _, node in nodes if not node.get('children'))\r\n261:     header = (\r\n262:         f'������ڽű��� YAML ��е������ժҪ��{len(nodes)} ������ڵ㣬����Ҷ������ {leaves} ����'\r\n263:         '���ڵ� description ԭ����¼���������谴��ȥ�أ�����������ͨ�ó���Լ����ֻ��һ�Σ�'\r\n264:         '�ڵ����� S ����������ӡ���Ҫ�˶�ԭ��ʱ�ٲ�ԭ�ļ�����'\r\n265:     )\r\n266:     out, used = [header], len(header)\r\n267:     for position, (node_id, block) in enumerate(blocks):\r\n268:         if used + len(block) + 2 > budget - 500:  # �����ض�˵����λ��\r\n269:             rest = [nid for nid, _ in blocks[position:] if nid is not None]\r\n270:             out.append(\r\n271:                 f'��ժҪ�����������ޣ��� {rest[0] if rest else \"�˴�\"} ��� {len(rest)} ���ڵ�δ������'\r\n272:                 '����ԭ�ļ���������id: <����ID>���ҵ���Ӧ�����ٶ