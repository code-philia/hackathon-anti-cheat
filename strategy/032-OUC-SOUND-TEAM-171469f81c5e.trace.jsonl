    cache_state_key = _cache_state_key(usage_scope, usage_scope_id)\r\n863:     cache = {\r\n864:         'key': _resolve_prompt_cache_key(\r\n865:             seq, conversation_id, prompt_cache_key, conversation_store,\r\n866:             state_key=cache_state_key,\r\n867:         ),\r\n868:         'store': conversation_store,\r\n869:         'conversation_id': conversation_id,\r\n870:         'state_key': cache_state_key,\r\n871:     }\r\n872:     usage_recorder = _UsageRecorder(\r\n873:         conversation_store, conversation_id, model,\r\n874:         scope=usage_scope, scope_id=usage_scope_id, billing=billing,\r\n875:     )\r\n876:     try:\r\n877:         # 星穹模式：进入时注入模式说明（不落库，每次运行注入一次）\r\n878:         if super_deep:\r\n879:             seq.system(SUPER_DEEP_GUIDE)\r\n880:         while True:\r\n881:             rounds += 1\r\n882:             if max_rounds is not None and rounds > max_rounds:\r\n883:                 yield {\r\n884:                     'type': 'error',\r\n885:                     'content': f'工具调用轮数超过上限（{max_rounds}），已中止本轮对话',\r\n886:                 }\r\n887:                 return\r\n888:             tools = prompt.build_tools()\r\n889:             if super_deep:\r\n890:                 # 星穹模式：额外注入 GoalFinishedTool（不注册进角色 Prompt，\r\n891:                 # 仅本模式可见；引擎检测到调用即结束）\r\n892:                 tools = [*tools, GOAL_FINISHED_TOOL.to_dict()]\r\n893:             _freeze_round_time(seq)\r\n894:             try:  # 历史超限就先压缩一次（模型总结，失败自动降级），不影响本轮请求\r\n895:                 maybe_compact(seq, model)\r\n896:             except Exception:  # noqa: BLE001\r\n897:                 pass\r\n898:             outcome = _RoundOutcome()\r\n899:             # 逻辑轮开始：重试与续写都发生在同一个 round 号内，前端据此合并展示\r\n900:             yield {'type': 'round_start', 'round': rounds}\r\n901:             try:\r\n902:                 yield from _stream_model_round(\r\n903:                     seq, prompt,\r\n904:                     tools=tools, model=model, effort=effort, thinking