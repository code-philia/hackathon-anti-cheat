3:     reporter = None\r\n484:     result = None\r\n485:     try:\r\n486:         project_note = prepare_output_dir(output_dir, template_dir)\r\n487:         task = build_task(req_path, output_dir, args.type, port, project_note)\r\n488:         if args.time_limit:\r\n489:             task += (\r\n490:                 f'\\n\\n## ʱ��Ԥ��\\n����������ʱ������Լ {int(args.time_limit) // 60} ���ӣ�����ᱻǿ����β��'\r\n491:                 '���Ⱦ��������ܹ���������������ҳ����Ҫ���̿��õİ汾����������󣻲�Ҫ�ڵ���������ͣ�����á�'\r\n492:             )\r\n493:         # ���·��ͳһ�����Ŀ¼���������ֹ��߲����������·����\r\n494:         os.chdir(output_dir)\r\n495:         reporter = ArcReporter(output_dir)\r\n496:         reporter.start(find_requirement_tree(req_path))\r\n497:         agent = AgentCore(\r\n498:             AgentConfig(\r\n499:                 model=model,\r\n500:                 cwd=str(output_dir),\r\n501:                 effort=args.effort,\r\n502:                 max_rounds=args.max_rounds,\r\n503:                 time_limit=args.time_limit,\r\n504:             ),\r\n505:             prompt=ArcBenchPrompt(reporter),\r\n506:             on_event=ConsoleReporter(),\r\n507:         )\r\n508:         result = agent.run(task)\r\n509:     except (KeyboardInterrupt, SystemExit):\r\n510:         print('[main] �յ��ж��źţ�ֹͣ����', file=sys.stderr, flush=True)\r\n511:         raise\r\n512:     except Exception:\r\n513:         print('[main] �����쳣��ֹ��', file=sys.stderr, flush=True)\r\n514:         traceback.print_exc()\r\n515:         return 1\r\n516:     finally:\r\n517:         killed = kill_all_async()\r\n518:         if killed:\r\n519:             print(f'[main] ��ֹͣ {killed} ���������еĺ�̨����', flush=True)\r\n520:         finalize(output_dir, port)\r\n521:         if reporter is not None:\r\n522:             ok = result is not None and result.ok\r\n523:             reporter.finish(ok, 'completed' if ok else ((result.error if result else None) or 'aborted'))\r\n524: \r\n525:     elapsed = time.monotonic() - started\r\n526:     usage = f'{result.tokens} tokens' + (f'������ {result.unknown_usage} ������δ֪' if result.unknown_usage else '')\r\n527:     print(\r\n528:         f'\\n[main] ������{result.status}��{result.rounds} �֣�{usage}����ʱ {elapsed:.0f}s'\r\n529:         + (f'\\n[main] ԭ��{result.error}' if result.error else ''),\r\n530:         flush=True,\r\n531:     )\r\n532:     # ʱ�䵽�����������β����Ŀ���ڹ���Ŀ¼��˳��� 0����ƽ̨�ճ������ѽ����Ĳ���\r\n533:     return 0 if result.status in ('completed', 'timeout') else 1\r\n534: \r\n535: \r\n536: if __name__ == '__main__':\r\n537:     sys.exit(main())\r\n\r\nFILE agent/core.py\r\n1: \"\"\"��ͷ Agent ��ڣ����������ı�����ָ������Ŀ¼���������� Agent ѭ����\r\n2: \r\n3: WebUI��server/��ֱ������ ``agent.engine.run_agent``����Ϊ����Ҫ�Ự�־û���\r\n4: ��ʽ���ͣ������� / ����ƽ̨ʹ�ñ�ģ�飺û�лỰ�⡢û��ǰ�ˣ������¼�����\r\n5: �ص�������``ConsoleReporter`` �����Ǵ�ӡ����־����\r\n6: \"\"\"\r\n7: \r\n8: from __future__ import annotations\r\n9: \r\n10: import json\r\n11: import sys\r\n12: import threading\r\n13: import time\r\n14: from dataclasses import dataclass\r\n15: from typing import Callable, TextIO\r\n16: \r\n17: from client import reasoning_effort_for\r\n18: from message import MessageSeq\r\n19: from prompt.base_prompt import ScenarioPrompt\r\n20: from prompt.lilliv3_code_prompt import Lilliv3CodePrompt\r\n21: \r\n22: from .engine import prepare_prompt, run_agent\r\n23: from .model_retry import ModelRetryExhausted\r\n24: \r\n25: \r\n26: @dataclass\r\n27: class AgentConfig:\r\n28:     model: str                        # ��ǰģ��Դ��Ǽǵ�ģ�� ID\r\n29:     cwd: str                          # ����Ŀ¼������Ĭ��ִ��Ŀ¼��Ҳд�� system prompt\r\n30:     effort: str = 'high'              # ��Ʒ��λ fast/turbo/high/max/ultra����ģ��ӳ��Ϊԭ�� effort\r\n31:     thinking: bool = True\r\n32:     max_rounds: int | None = None     # ģ�������������ޣ�None ����\r\n33:     super_deep: bool = False          # ֻ��ģ�͵��� GoalFinishedTool �Ž���\r\n34:     time_limit: float | None = None   # �룻���������һ��ģ������ / ���߽߱�ֹͣ\r\n35: \r\n36: \r\n37: @dataclass\r\n38: class AgentResult:\r\n39:     status: str                       # 'completed' | 'failed' | 'timeout'\r\n40:     final_message: str                # ���һ�������ĵ� assistant ��Ϣ\r\n41:     rounds: int\r\n42:     error: str | None = None\r\n43:     tokens: int = 0\r\n44:     unknown_usage: int = 0            # ����û�����������������\r\n45: \r\n46:     @property\r\n47:     def ok(self) -> bool:\r\n48:         return self.status == 'completed'\r\n49: \r\n50: \r\n51: class AgentCore:\r\n52:     \"\"\"``AgentCore(config).run(task)``��һ������������ֵ�ص� Agent ���С�\"\"\"\r\n53: \r\n54:     def __init__(\r\n55:         self,\r\n56:         config: AgentConfig,\r\n57:         prompt: ScenarioPrompt | None = None,\r\n58:         on_event: Callable[[dict], None] | None = None,\r\n59:     ) -> None:\r\n60:         self.config = config\r\n61:         self.prompt = prompt\r\n62:         self.on_event = on_event\r\n63: \r\n64:     def run(self, task: str) -> AgentResult:\r\n65:         cfg = self.config\r\n66:         prompt = prepare_prompt(self.prompt or Lilliv3CodePrompt(), cfg.model)\r\n67:         prompt.cwd = cfg.cwd\r\n68:         seq = MessageSeq()\r\n69:         seq.system(prompt.build())\r\n70:         seq.user(task)\r\n71: \r\n72:         cancel = threading.Event()\r\n73:         timer = None\r\n74:         if cfg.time_limit:\r\n75:             timer = threading.Timer(cfg.time_limit, cancel.set)\r\n76:             timer.daemon = True\r\n77:             timer.start()\r\n78: \r\n79:         rounds = tokens = unknown = 0\r\n80:         error = None\r\n81:         try:\r\n82:             for event in run_agent(\r\n83:                 seq, prompt, cfg.model,\r\n84:                 effort=reasoning_effort_for(cfg.model, cfg.effort),\r\n85:                 thinking=cfg.thinking,\r\n86:                 max_rounds=cfg.max_rounds,\r\n87:                 super_deep=cfg.super_deep,\r\n88:                 cwd=cfg.cwd,\r\n89:                 cancel_event=cancel,\r\n90:             ):\r\n91:                 kind = event.get('type')\r\n92:                 if kind == 'round_start':\r\n93:                     rounds = event.get('round') or rounds\r\n94:                 elif kind == 'usage':\r\n95:                     usage = event.get('usage') or {}\r\n96:                     if usage.get('unknown'):\r\n97:                         unknown += 1\r\n98:                     else:\r\n99:                         tokens += int(usage.get('total_tokens') or 0)\r\n100:                 elif kind == 'error':\r\n101:                     error = event.get('content') or 'δ֪����'\r\n102:                 if self.on_event is not None:\r\n103:                     self.on_event(event)\r\n104:         except ModelRetryExhausted as exc:\r\n105:             # error ���Ѿ�������������ֻ��֤�������ԭ��\r\n106:             error = error or str(exc)\r\n107:         finally:\r\n108:             if timer is not None:\r\n109:                 timer.cancel()\r\n110: \r\n111:         if cancel.is_set():\r\n112:             status = 'timeout'\r\n113:             error = error or f'����ʱ������ {cfg.time_limit:g} �룬��ֹͣ'\r\n114:         elif error:\r\n115:             status = 'failed'\r\n116:         else:\r\n117:             status = 'completed'\r\n118:         return AgentResult(\r\n119:             status=status,\r\n120:             final_message=_final_message(seq),\r\n121:             rounds=rounds,\r\n122:             error=error,\r\n123:             tokens=tokens,\r\n124:             unknown_usage=unknown,\r\n125:         )\r\n126: \r\n127: \r\n128: def _final_message(seq: MessageSeq) -> str:\r\n129:     for message in reversed(seq.to_list()):\r\n130:         if message.get('role') == 'assistant' and (message.get('content') or '').strip():\r\n131:             return message['content'].strip()\r\n132:     return ''\r\n133: \r\n134: \r\n135: def _clip(text: str, limit: int) -> str:\r\n136:     text = text or ''\r\n137:     return text if len(text) <= limit else text[:limit] + f'����ʡ�� {len(text) - limit} �֣�'\r\n138: \r\n139: \r\n140: def _format_args(raw: str, limit: int) -> str:\r\n141:     \"\"\"���߲�������ֶ���ʾ�����ı�ֻ����ͷ������ܳ�����֤ path �ȶ��ֶ����ܿ�����\"\"\"\r\n142:     try:\r\n143:         args = json.loads(raw or '{}')\r\n144:     except ValueError:\r\n145:         return _clip(raw, limit)  # ����������������ظ����ضϣ�ʱ��ԭ�Ľض���ʾ\r\n146:     if not isinstance(args, dict):\r\n147:         return _clip(raw, limit)\r\n148:     parts = []\r\n149:     for key, value in args.items():\r\n150:         text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)\r\n151:         if len(text) > 120:\r\n152:             text = f'{text[:80]}������ {len(text)} �֣�'\r\n153:         parts.append(f'{key}={text!r}' if isinstance(value, str) else f'{key}={text}')\r\n154:     return _clip(' '.join(parts), limit)\r\n155: \r\n156: \r\n157: class ConsoleReporter:\r\n158:     \"\"\"�������¼���ӡ�����ܶ�����־��������ʽ��������ߵ�����������һ�С�\r\n159: \r\n160:     �������̡������ȸ�Ƶ�¼�����ӡ�������ڽ���ʱ�ɵ��÷����ܣ���\r\n161:     \"\"\"\r\n162: \r\n163:     def __init__(self, stream: TextIO | None = None, *, arg_limit: int = 400, result_limit: int = 1500):\r\n164:         self.stream = stream or sys.stdout\r\n165:         self.arg_limit = arg_limit\r\n166:         self.result_limit = result_limit\r\n167:         self._calls: dict[str, dict] = {}\r\n168:         self._mid_line = False\r\n169: \r\n170:     def __call__(self, event: dict) -> None:\r\n171:         kind = event.get('type')\r\n172:         if kind == 'round_start':\r\n173:             self._round_t = time.monotonic()\r\n174:             self._line(f'\\n===== �� {event.get(\"round\")} �� =====')\r\n175:         elif kind == 'usage':\r\n176:             u = event.get('usage') or {}\r\n177:             if not u.get('unknown') and getattr(self, '_round_t', None) is not None:\r\n178:                 sec = time.monotonic() - self._round_t\r\n179:                 comp = int(u.get('completion_tokens') or 0)\r\n180:                 prompt = int(u.get('prompt_tokens') or 0)\r\n181:                 hit = int(u.get('prompt_cache_hit_tokens') or 0)\r\n182:                 self._line(\r\n183:                     f'[����] ��ʱ {sec:.0f}s ���� {prompt}'\r\n184:                     f'���������� {hit}��{hit * 100 // prompt if prompt else 0}%��'\r\n185:                     f' ��� {comp}��{comp / sec if sec > 0 else 0:.0f} tok/s��'\r\n186:                 )\r\n187:         elif kind == 'content':\r\n188:             self.stream.write(event.get('content') or '')\r\n189:             self.stream.flush()\r\n190:             self._mid_line = True\r\n191:         elif kind == 'tool':\r\n192:             call_id = event.get('id') or ''\r\n193:             if event.get('new') or call_id not in self._calls:\r\n194:                 self._calls[call_id] = {'name': event.get('name') or '?', 'args': ''}\r\n195:             self._calls[call_id]['args'] += event.get('content') or ''\r\n196:         elif kind == 'finish':\r\n197:             for call in self._calls.values():\r\n198:                 self._line(f'-> {call[\"name\"]} {_format_args(call[\"args\"], self.arg_limit)}')\r\n199:             self._calls.clear()\r\n200:             if event.get('content') not in ('stop', 'tool_calls'):\r\n201:                 self._line(f'[���ֽ���ԭ��finish_reason={event.get(\"content\")}]')\r\n202:         elif kind == 'tool_result':\r\n203:             mark = 'OK' if event.get('ok', True) else 'FAIL'\r\n204:             self._line(f'   [{mark}] {_clip(event.get(\"content\") or \"\", self.result_limit)}')\r\n205:         elif kind == 'retry':\r\n206:             self._line(\r\n207:                 f'[���� {event.get(\"attempt\")}/{event.get(\"max_retries\")}��'\r\n208:                 f'{float(event.get(\"delay\") or 0):.1f}s ��] {event.get(\"content\") or \"\"}'\r\n209:                 f'�����������Ѻ�ʱ {event.get(\"elapsed\")}s��'\r\n210:                 f'{\"����;�ж�\" if event.get(\"got_data\") else \"���ֽ�ǰ����Ӧ\"}��'\r\n211:             )\r\n212:         elif kind == 'error':\r\n213:             self._line(f'[����] {event.get(\"content\") or \"\"}')\r\n214:         elif kind == 'subagent':\r\n215:             self._subagent(event)\r\n216: \r\n217:     def _subagent(self, event: dict) -> None:\r\n218:         state = event.get('state')\r\n219:         if state == 'start':\r\n220:             self._line(f'[�Ӵ��� {event.get(\"id\", \"\")[:8]}] ��ʼ��{_clip(event.get(\"task\") or \"\", 300)}')\r\n221:         elif state == 'done':\r\n222:             tag = 'δ���' if event.get('aborted') else '���'\r\n223:             self._line(f'[�Ӵ��� {event.get(\"id\", \"\")[:8]}] {tag}��{_clip(event.get(\"result\") or \"\", 800)}')\r\n224:         else:\r\n225:             sub = event.get('sub') or {}\r\n226:             if sub.get('type') == 'tool_result':\r\n227:                 mark = 'OK' if sub.get('ok', True) else 'FAIL'\r\n228:                 self._line(f'   [�Ӵ���][{mark}] {_clip(sub.get(\"content\") or \"\", 300)}')\r\n229:             elif sub.get('type') == 'error':\r\n230:                 self._line(f'   [�Ӵ���][����] {sub.get(\"content\") or \"\"}')\r\n231: \r\n232:     def _line(self, text: str) -> None:\r\n233:         if self._mid_line:\r\n234:             self.stream.write('\\n')\r\n235:             self._mid_line = False\r\n236:         self.stream.write(text + '\\n')\r\n237:         self.stream.flush()\r\n\r\nFILE tools/skill_tools.py\r\n1: \"\"\"���ܹ��߳�����ࡣ\r\n2: \r\n3: SkillTool��һ�֡����ܡ��๤�ߡ���ÿ�����ܶ�Ӧһ�����·���µ� Markdown ˵���ļ���\r\n4: ����ʱ�����κβ�����execute() ֻ���ȡ�����ظ� md �ļ������ݡ�\r\n5: ������ʵ�� name / description����ָ�������ĵ������·�� md_path��\r\n6: \"\"\"\r\n7: \r\n8: from abc import ABC\r\n9: from pathlib import Path\r\n10: from typing import Any\r\n11: import os\r\n12: \r\n13: from tools.base_tool import Tool, noop_consumer\r\n14: \r\n15: # �� Agent һ��ַ������� Skill Ŀ¼��<��Ŀ��>/skills/<name>/SKILL.md\r\n16: BUNDLED_SKILLS_DIR = Path(__file__).resolve().parent.parent / 'skills'\r\n17: \r\n18: \r\n19: class SkillTool(Tool, ABC):\r\n20:     \"\"\"���ܹ��߳�����ࡣ\r\n21: \r\n22:     �̳��� Tool���������� name / description ��������ʵ�֣�\r\n23:     parameters �̶�Ϊ�գ��޲�������execute �̶�Ϊ����ȡ������ md �ļ�����\r\n24:     ����ʾ����\r\n25: \r\n26:         class GreetingSkill(SkillTool):\r\n27:             name = 'greeting_skill'\r\n28:             description = '����һ��ů�ĵĿ�������˵����'\r\n29:             md_path = 'skills/greeting.md'\r\n30: \r\n31:     ���øù���ʱ���贫�Σ����� md_path ָ��� Markdown �ļ����ݡ�\r\n32: \r\n33:     ��ʾ�İ���Ϊ�༶ȫ�ֱ���������ɸ�дΪ���Ի�˵�������磺\r\n34: \r\n35:         class SecretSkill(SkillTool):\r\n36:             msg_loaded = '����һ��Сֽ��'\r\n37:             msg_not_found = 'Сֽ�������ˣ�{path}'\r\n38:     \"\"\"\r\n39: \r\n40:     # ���� �����ĵ�·�� ������������������������������������������������������������������\r\n41:     # ���·�������� base_dir ��������������븲д��\r\n42:     md_path: str = ''\r\n43: \r\n44:     # ���·���Ļ�׼Ŀ¼��Ĭ�ϵ�ǰ����Ŀ¼������ɰ��踲д\r\n45:     # ��������ڼ����ļ�����Ŀ¼��os.path.dirname(os.path.abspath(__file__))����\r\n46:     base_dir: str = os.getcwd()\r\n47: \r\n48:     # ���� ��ʾ�İ����༶ȫ�ֱ���������ɸ�д���Ի���������������\r\n49:     msg_not_found: str = 'δ�ҵ������ĵ�'\r\n50:     msg_read_failed: str = '��ȡ�����ĵ�ʧ��'\r\n51:     msg_loaded: str = '�����뼼�ܣ�{name}'\r\n52: \r\n53:     @property\r\n54:     def parameters(self) -> dict[str, Any]:\r\n55:         \"\"\"���ܹ������������\"\"\"\r\n56:         return {}\r\n57: \r\n58:     def _resolve_path(self) -> str:\r\n59:         \"\"\"�� md_path ����Ϊ����·����\"\"\"\r\n60:         return os.path.join(self.base_dir, self.md_path)\r\n61: \r\n62:     def execute(self, result_consumer=None, **kwargs) -> str | dict:\r\n63:         \"\"\"��ȡ�����ؼ���˵�� md �ļ����ݣ��޲�������\"\"\"\r\n64:         result_consumer = result_consumer or noop_consumer\r\n65:         path = self._resolve_path()\r\n66:         try:\r\n67:             with open(path, 'r', encoding='utf-8') as f:\r\n68:                 content = f.read()\r\n69:         except FileNotFoundError:\r\n70:             msg = self.msg_not_found.format(path=path)\r\n71:             result_consumer(msg, False)\r\n72:             return {'ok': False, 'msg': msg}\r\n73:         except Exception as e:\r\n74:             msg = self.msg_read_failed.format(e=e)\r\n75:             result_consumer(msg, False)\r\n76:             return {'ok': False, 'msg': msg}\r\n77: \r\n78:         result_consumer(self.msg_loaded.format(name=self.name))\r\n79:         return content\r\n80: \r\n81: \r\n82: class BundledSkills:\r\n83:     \"\"\"ɨ������ skills Ŀ¼������Ŀ¼�鲢���������롣\r\n84: \r\n85:     Frontmatter ֻ��Ҫ���� ``name:`` / ``description:``�����н����������� PyYAML��\r\n86:     \"\"\"\r\n87: \r\n88:     def __init__(self, root: str | os.PathLike | None = None) -> None:\r\n89:         self.root = Path(root) if root else BUNDLED_SKILLS_DIR\r\n90: \r\n91:     @staticmethod\r\n92:     def _frontmatter(text: str) -> dict[str, str]:\r\n93:         lines = text.lstrip('\\ufeff').splitlines()\r\n94:         if not lines or lines[0].strip() != '---':\r\n95:             return {}\r\n96:         meta: dict[str, str] = {}\r\n97:         for line in lines[1:]:\r\n98:             if line.strip() == '---':\r\n99:                 break\r\n100:             key, sep, value = line.partition(':')\r\n101:             if sep:\r\n102:                 meta[key.strip()] = value.strip().strip('\"\\'')\r\n103:         return meta\r\n104: \r\n105:     def scan(self) -> dict[str, dict[str, Any]]:\r\n106:         skills: dict[str, dict[str, Any]] = {}\r\n107:         if not self.root.is_dir():\r\n108:             return skills\r\n109:         for skill_file in sorted(self.root.glob('*/SKILL.md')):\r\n110:             meta = self._frontmatter(skill_file.read_text(encoding='utf-8'))\r\n111:             name = meta.get('name') or skill_file.parent.name\r\n112:             skills[name] = {\r\n113:                 'description': meta.get('description', ''),\r\n114:                 'file': skill_file,\r\n115:             }\r\n116:         return skills\r\n117: \r\n118:     def names(self) -> list[str]:\r\n119:         return list(self.scan().keys())\r\n120: \r\n121:     def catalog_block(self) -> str:\r\n122:         skills = self.scan()\r\n123:         if not skills:\r\n124:             return ''\r\n125:         lines = [\r\n126:             '# ���� Skills',\r\n127:             '���� Skill �Ǿ�����֤��������ģ�塣������������ʱ���ȵ��� `load_skill(name)` �����ٶ��֣�'\r\n128:             '��Ҫƾӡ��²� Skill ���ݡ�',\r\n129:             '**��Ŀר��ָ�ϣ�`spreadsheet-app-guide`��`github-collab-guide`���Դ� `references/`�������еĲο�ʵ�֣���'\r\n130:             '��Ŀƥ��ʱ�������룬������ȶ���Ǽܣ�֮��ÿ��һ�� REQ ֮ǰ�� read_file ��Ӧ�Ĳο��ļ�����д���롣'\r\n131:             '�����ο�ʵ�֡��Լ�ƾ����ƣ��������ʧ��ԭ��**',\r\n132:         ]\r\n133:         lines += [f'- `{name}`��{info[\"description\"]}' for name, info in skills.items()]\r\n134:         return '\\n'.join(lines)\r\n135: \r\n136:     def load(self, name: str) -> str:\r\n137:         info = self.scan().get(name)\r\n138:         if info is None:\r\n139:             raise KeyError(f'δ�ҵ� Skill��{name}�����ã�{\"��\".join(self.names())}��')\r\n140:         skill_file: Path = info['file']\r\n141:         root = skill_file.parent\r\n142:         skip_dirs = {'node_modules', 'dist', '.git', '__pycache__'}  # �ο�ʵ���Դ��������빹��������г�\r\n143:         extras = sorted(\r\n144:             p.relative_to(root).as_posix()\r\n145:             for p in root.rglob('*')\r\n146:             if p.is_file() and p != skill_file and not skip_dirs.intersection(p.relative_to(root).parts)\r\n147:         )\r\n148:         header = f'# �Ѽ��� Skill��{name}\\n- Skill ��Ŀ¼��`{root}`\\n'\r\n149:         if any(p.startswith('references/') for p in extras):\r\n150:             header += (\r\n151:                 f'- **����һ��������** ��� Skill �������еĲο�ʵ�� `{root / \"references\"}`��'\r\n152:                 '�Ȱ����� SKILL.md ��ָ�������ĹǼܣ�֮��ÿ��һ�� REQ ֮ǰ�� read_file ��Ӧ�Ĳο��ļ���д���롣'\r\n153:                 '����ʱ��Ҫ�� node_modules / dist / data / e2e����Ҫ��ƾ����� SKILL.md �Ϳ�����\\n'\r\n154:             )\r\n155:         if extras:\r\n156:             header += '- �����ļ����� read_file / copy_file ����ʹ�ã�·����� Skill ��Ŀ¼����\\n'\r\n157:             header += ''.join(f'  - `{p}`\\n' for p in extras)\r\n158:         return header + '\\n' + skill_file.read_text(encoding='utf-8')\r\n159: \r\n160: \r\n161: class LoadBundledSkillTool(Tool):\r\n162:     \"\"\"����������һ������ Skill ������ SKILL.md��\"\"\"\r\n163: \r\n164:     _display_name = '����Skill'\r\n165: \r\n166:     def __init__(self, skills: BundledSkills | None = None) -> None:\r\n167:         self._skills = skills or BundledSkills()\r\n168: \r\n169:     @property\r\n170:     def name(self) -> str:\r\n171:         return 'load_skill'\r\n172: \r\n173:     @property\r\n174:     def description(self) -> str:\r\n175:         return '�����Ƽ���һ������ Skill ������˵��������Ŀ¼��ɸ��Ƶ�ģ���ļ��嵥������������ Skill ����ʱ���á�'\r\n176: \r\n177:     @property\r\n178:     def parameters(self) -> dict[str, Any]:\r\n179:         schema: dict[str, Any] = {'type': 'string', 'description': 'Ҫ���ص� Skill ����'}\r\n180:         names = self._skills.names()\r\n181:         if names:\r\n182:             schema['enum'] = names\r\n183:         return {'name': schema}\r\n184: \r\n185:     required_parameters = ('name',)\r\n186: \r\n187:     def execute(self, name: str = '', result_consumer=None, **kwargs) -> str:\r\n188:         consumer = result_consumer or noop_consumer\r\n189:         try:\r\n190:             loaded = self._skills.load(name)\r\n191:         except (KeyError, OSError) as exc:\r\n192:             consumer(str(exc), False)\r\n193:             return f'���� Skill ʧ�ܣ�{exc}'\r\n194:         consumer(f'�Ѽ��� Skill��{name}')\r\n195:         return loaded\r\n196: \r\n197: \r\n\r\nFILE prompt/lilliv3_code_prompt.py\r\n1: \r\n2: from prompt.base_prompt import ScenarioPrompt\r\n3: \r\n4: from tools import (\r\n5:     Tool,\r\n6:     ReadFileTool,\r\n7:     ListDirTool,\r\n8:     GlobTool,\r\n9:     GrepTool,\r\n10:     FileInfoTool,\r\n11:     WriteFileTool,\r\n12:     EditFileTool,\r\n13:     CreateDirTool,\r\n14:     CopyFileTool,\r\n15:     MoveFileTool,\r\n16:     DeleteFileTool,\r\n17:     ShellExecTool,\r\n18:     ShellGetOutputTool,\r\n19:     ShellKillTool,\r\n20:     ShellSendInputTool,\r\n21:     HttpRequestTool,\r\n22:     TODO_TOOL,\r\n23: )\r\n24: \r\n25: import os\r\n26: \r\n27: \r\n28: class Lilliv3CodePrompt(ScenarioPrompt):\r\n29: \r\n30:     display_name = 'Lilliv3 Code'\r\n31:     enable_visualization = True\r\n32:     enable_document_conversion = True\r\n33: \r\n34:     # ���� ά�ȣ�������֪��Agent ���Լ��ڵ�ǰ���������ݵĶ�λ������\r\n35:     self_identity: str = f\"\"\"\r\n36: ���� Lilliv3 Code��Lilliv3 ��֧�ı�̹��ߡ�\r\n37: ����һ���������е�agent������������������������\r\n38: ��ʹ�������ָ���Լ�����õĹ�����Э���û���\r\n39: \"\"\"\r\n40: \r\n41:     # ���� ά�ȣ��������� ����\r\n42:     capability: str = '''\r\n43: �û���Ҫ��Ҫ����ִ��������������\r\n44: ��Щ������ܰ����޸� bug�������¹��ܡ��ع����롢���ʹ���ȡ�\r\n45: ���յ������򷺻���ָ��ʱ��Ҫ�����Щ�������������Լ���ǰ����Ŀ¼�������û���ͼ��\r\n46: ���磬����û�Ҫ��� methodName �ĳ� snake case����Ҫֻ�ظ� method_name������Ӧ���ڴ������ҵ����������ֱ���޸Ĵ��롣'''\r\n47: \r\n48:     # ���� ά�ȣ���Ϊ׼�� ����\r\n49:     behavior: str = '''\r\n50: ������û�������û����ߣ����й��ߵ��ö��ᱻֱ��ִ�У��������κ�ȷ�ϻ�ѯ�ʻ��ڣ�Ҳ�޷����κ������ʡ�\r\n51: ������ȷ���ĵط�����������������Ϣ������������жϲ������ƽ�����Ҫͣ�����ȴ��ظ���\r\n52: \r\n53: һ����˵����Ҫ����û�ж����Ĵ�������޸Ľ��顣\r\n54: ��������漰ĳ���ļ����Ȱ�����һ�顣\r\n55: ���޸�֮ǰ�����������д��롣\r\n56: �ļ������ڴ�ǰ״̬֮�󱻸Ķ��������ֲ�һ�£������¶�ȡ�����޸ġ�\r\n57: \r\n58: ��߱���ǿ�������������ܰ��������Щԭ�����ڸ��ӻ��ʱ���������