38:                 fresh += [r for r in self._req_ids(item) if r not in fresh]\r\n139:             if started:  # 开始做：让平台的需求树实时显示「实现中」，不做 git 提交\r\n140:                 self._reporter.report(\r\n141:                     [{'req_id': r, 'state': 'implementing'} for r in started], commit=False,\r\n142:                 )\r\n143:             if fresh:\r\n144:                 self._reporter.report(\r\n145:                     [{'req_id': r, 'state': 'implemented'} for r in fresh],\r\n146:                     f'{fresh[0]} (implement): {len(fresh)} requirement(s) done',\r\n147:                 )\r\n148:         except Exception:\r\n149:             _warn('todo 自动上报')\r\n150:         return result\r\n151: \r\n152: \r\n153: class ArcShellExecTool(ShellExecTool):\r\n154:     \"\"\"shell_exec + 自动上报：命令输出里的 `PASS REQ-x` / `FAIL REQ-x` 行 -> 测试通过/失败。\r\n155: \r\n156:     模型很少主动调用 arc_report，但它自己的验证脚本会按需求 ID 打印结果行，直接从输出里取。\r\n157:     同一需求只要出现过 FAIL 就按失败上报；状态没变化不重复上报。\r\n158:     \"\"\"\r\n159: \r\n160:     def __init__(self, reporter: ArcReporter) -> None:\r\n161:         self._reporter = reporter\r\n162:         self._states: dict[str, str] = {}\r\n163: \r\n164:     def execute(self, *args, **kwargs):\r\n165:         result = super().execute(*args, **kwargs)\r\n166:         try:\r\n167:             output = result.get('output') if isinstance(result, dict) else None\r\n168:             if output:\r\n169:                 verdict: dict[str, str] = {}\r\n170:                 for word, req_id in _RESULT_LINE.findall(output):\r\n171:                     known = self._reporter.known_ids\r\n172:                     if known and req_id not in known:\r\n173:                         continue\r\n174:                     if word == 'FAIL':\r\n175:                         verdict[req_id] = 'failed'\r\n176:                     else:\r\n177:                         verdict.setdefault(req_id, 'passed')\r\n178:                 changed = [\r\n179:                     {'req_id': r, 'state': s} for r, s in verdict.items()\r\n180:                     if self._states.get(r) != s\r\n181:                 ]\r\n182:                 if changed:\r\n183:                     for item in changed:\r\n184:                         self._states[item['req_id']] = item['state']\r\n185:                     self._reporter.report(changed, f'{changed[0][\"req_id\"]} (test): {len(changed)} requirement(s)')\r\n186:         except Exception:\r\n187:             _warn('shell 输出自动上报')\r\n188:         return result\r\n189: \r\n190: \r\n","exit_code":0,"status":"completed"}}
