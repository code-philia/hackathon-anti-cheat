e = call['function']['name']\r\n1296:     tool = prompt.get_tool_by_name(t_name)\r\n1297:     if not tool:\r\n1298:         msg = f'调用了未知的工具 {t_name}'\r\n1299:         seq.tool(f'未知的工具: {t_name}', call['id'])\r\n1300:         yield {\r\n1301:             'type': 'tool_result', 'content': msg, 'ok': False,\r\n1302:             'tool_call_id': call['id'],\r\n1303:             'raw_json': json.dumps({'error': msg}, ensure_ascii=False),\r\n1304:         }\r\n1305:         return\r\n1306:     # 流式工具（subagent）：启动独立子循环，逐段包装为 subagent 流段\r\n1307:     if getattr(tool, 'streaming', False):\r\n1308:         yield from _execute_subagent_stream(\r\n1309:             seq, prompt, call,\r\n1310:             model=model,\r\n1311:             effort=effort,\r\n1312:             thinking=thinking,\r\n1313:             max_rounds=max_rounds,\r\n1314:             cwd=cwd,\r\n1315:             conversation_id=conversation_id,\r\n1316:             conversation_store=conversation_store,\r\n1317:             cancel_event=cancel_event,\r\n1318:         )\r\n1319:         return\r\n1320:     events: list[dict] = []\r\n1321: \r\n1322:     def consumer(msg: str, ok: bool = True) -> None:\r\n1323:         events.append({'msg': msg, 'ok': ok})\r\n1324:     try:\r\n1325:         t_args = json.loads(call['function']['arguments'])\r\n1326:     except Exception as e:\r\n1327:         msg = f'参数解析异常：{e}'\r\n1328:         seq.tool(f'参数解析异常： {str(e)}', call['id'])\r\n1329:         yield {\r\n1330:             'type': 'tool_result', 'content': msg, 'ok': False,\r\n1331:             'tool_call_id': call['id'],\r\n1332:             'raw_json': json.dumps({'error': msg}, ensure_ascii=False),\r\n1333:         }\r\n1334:         return\r\n1335:     try:\r\n1336:         ref = tool.execute(\r\n1337:             **t_args,\r\n1338:             result_consumer=consumer,\r\n1339:             __conversation_id__=conversation_id,\r\n1340:             __state_store__=conversation_store,\r\n1341:             __cwd__=cwd,\r\n1342:             __model__=model,\r\n1343:             __message_seq__=seq,\r\n1344:         )\r\n1345:         generated_outputs = seq.image_outputs()\r\n1346:     except Exception as e:\r\n1347:         msg = f'调用 {t_name} 发生异常：{e}'\r\n1348:         seq.tool(f'调用工具 {t_name} 发生异常： {str(e)}', call['id'])\r\n1349:         yield {\r\n1350:             'type': 'tool_result', 'content': msg, 'ok': False,\r\n1351:             'tool_call_id': call['id'],\r\n1352:             'raw_json': json.dumps({'error': msg}, ensure_ascii=False),\r\n1353:         }\r\n1354:         return\r\n1355:     if isinstance(ref, dict):\r\n1356:         ref = json.dumps(ref, ensure_ascii=False)\r\n1357:     if not isinstance(ref, str):\r\n1358:         msg = f'{t_name} 返回了无法识别的结果'\r\n1359:         seq.tool('wtf??? how i messed up', call['id'])\r\n1360:         yield {\r\n1361:             'type': 'tool_result', 'content': msg, 'ok': False,\r\n1362:             'tool_call_id': call['id'],\r\n1363:             'raw_json': json.dumps({'error': msg}, ensure_ascii=False),\r\n1364:         }\r\n1365:         return\r\n1366:     # result_consumer 收集的友好提示也随 tool 消息一起保存（用于历史回放），\r\n1367:     # 格式与流式 tool_result 段一致：{content, ok}\r\n1368:     seq.tool(\r\n1369:         ref,\r\n1370:         call['id'],\r\n1371:         tool_results=[{'content': ev['msg'], 'ok': ev['ok']} for ev in events],\r\n1372:     )\r\n1373:     # 工具执行结束后，把友好提示与原始结果一并产出给前端；call id 让并行/\r\n1374:     # 连续工具调用可精确归属。未提供友好提示时也产出一条稳定的完成摘要，\r\n1375:     # 保证详情 Alert 在实时阶段即可读取原始 JSON。\r\n1376:     if events:\r\n1377:         for ev in events:\r\n1378:             yield {\r\n1379:                 'type': 'tool_result',\r\n1380:                 'content': ev['msg'],\r\n\r\nFILE agent/engine.py\r\n1470:     - 用户取消 → 同样保存进展并闭合父调用，但把 ``RunCancelled`` 继续上抛，\r\n1471:       主代理**不得**接着跑；\r\n1472:     - 生成器被关闭（浏览器断开 / RunManager 取消后 ``gen.close()``）→ 与取消\r\n1473:       同样保存进展并闭合父调用，但**不产出任何事件**（关闭期间禁止 yield），\r\n1474:       也不恢复父请求，随后把 ``GeneratorExit`` 原样上抛。\r\n1475:     \"\"\"\r\n1476:     sub_id = uuid.uuid4().hex\r\n1477:     try:\r\n1478:         t_args = json.loads(call['function'].get('arguments') or '{}')\r\n1479:     except Exception:\r\n1480:         t_args = {}\r\n1481:     task = t_args.get('task') or ''\r\n1482:     system_override = t_args.get('system')\r\n1483:     sub_model = t_args.get('model') or model\r\n1484:     if not sub_model:\r\n1485:         raise RuntimeError('子代理未指定模型，且父代理没有可继承的模型')\r\n1486:     sub_cwd = t_args.get('cwd') or cwd\r\n1487:     sub_prompt = make_subagent_prompt(prompt, task, system_override, sub_cwd)\r\n1488:     # 子任务既保留在 system 的约束说明中，也作为真实 user 消息发出。\r\n1489:     # 后者避免上游自动 Prompt Cache 注入器面对 system-only 首轮时生成空标记。\r\n1490:     sub_seq = create_subagent_seq(sub_prompt, task)\r\n1491:     billing = new_billing(sub_model)\r\n1492: \r\n1493:     sub_events: list[dict] = []\r\n1494:     stats = {'tokens': 0, 'error': None}\r\n1495:     # start 段本身也在保护范围内：上层可能正好在这个 yield 上关闭生成器，\r\n1496:     # 此时父 assistant 已经带着 tool_calls 写进历史，必须照样闭合。\r\n1497:     try:\r\n1498:         yield {\r\n1499:             'type': 'subagent',\r\n1500:             'id': sub_id,\r\n1501:             'state': 'start',\r\n1502:             'task': task,\r\n1503:             # 前端据此在卡片上展示真实子模型与实时累计费用\r\n1504:             'model': sub_model,\r\n1505:             'cost': 0.0,\r\n1506:             'cost_complete': True,\r\n1507:             'unknown_cost_attempts': 0,\r\n1508:         }\r\n1509:         yield from _forward_subagent_events(\r\n1510:             run_agent(\r\n1511:                 sub_seq,\r\n1512:                 sub_prompt,\r\n1513:                 sub_model,\r\n1514:                 effort=effort,\r\n1515:                 thinking=thinking,\r\n1516:                 max_rounds=_subagent_max_rounds(max_rounds),\r\n1517:                 cwd=sub_cwd,\r\n1518:                 prompt_cache_key=sub_id,\r\n1519:                 conversation_store=conversation_store,\r\n1520:                 conversation_id=conversation_id,\r\n1521:                 # 子代理有独立上下文：只记账，不把子消息写进父会话\r\n1522:                 persist_messages=False,\r\n1523:                 usage_scope=SCOPE_SUBAGENT,\r\n1524:                 usage_scope_id=sub_id,\r\n1525:                 billing=billing,\r\n1526:                 cancel_event=cancel_event,\r\n1527:                 cancel_root=False,\r\n1528:             ),\r\n1529:             sub_id,\r\n1530:             sub_events,\r\n\r\nFILE context_compaction.py\r\n1: \"\"\"上下文压缩：超限时把较早的对话历史交给模型总结成一份「进度摘要」，只保留最近的完整消息。\r\n2: \r\n3: 结构：[系统提示, 任务(首条 user)] + [摘要(user)] + [最近若干组完整的 assistant/tool 消息]\r\n4: \r\n5: - 总结由模型完成（评测用的 kimi 很快，一次几秒）；模型不可用 / 超时 / 输出为空时降级为\r\n6:   机械摘要（每次工具调用一行），压缩绝不阻塞主流程。\r\n7: - 摘要生成一次就存进 seq，之后每个请求复用同一份文本：两次压缩之间消息前缀逐字节稳定，\r\n8:   Kimi / DeepSeek 等按前缀自动缓存的模型不会因为压缩而失去缓存。\r\n9: - 视图只影响发给模型的消息，不改 MessageSeq 里的完整历史。\r\n10: - 按「assistant(tool_calls) + 其全部 tool 结果」成组裁剪，tool_call / tool 配对永远合法。\r\n11: \"\"\"\r\n12: \r\n13: from __future__ import annotations\r\n14: \r\n15: import json\r\n16: \r\n17: # 首条 user 消息（任务）之后的历史超过这个字符数就压缩（约 35~50 万 token）。\r\n18: # 1M 窗口还要给 max_tokens=384K 的输出预留位置（输入 + max_tokens 不得超过窗口），所以输入须 ≲ 60 万 token。\r\n19: HISTORY_LIMIT_CHARS = 1_000_000\r\n20: # 压缩后保留的最近历史大小\r\n21: KEEP_RECENT_CHARS = 350_000\r\n22: # 无论多大，至少保留最近这么多组\r\n23: MIN_KEEP_GROUPS = 4\r\n24: # 喂给总结模型的材料上限（超出时保留较新的部分）与摘要上限\r\n25: SUMMARY_INPUT_MAX_CHARS = 500_000\r\n26: SUMMARY_MAX_CHARS = 6_000\r\n27: # 机械摘要（降级用）的上限\r\n28: DIGEST_MAX_CHARS = 30_000\r\n29: \r\n30: _ARG_KEYS = ('path', 'cmd', 'pattern', 'url', 'name', 'action', 'todo_id', 'task_id', 'query')\r\n31: \r\n32: SUMMARY_SYSTEM = (\r\n33:     '你是编码智能体的「上下文压缩器」。下面是该智能体较早的工作记录（工具调用及结果概要），'\r\n34:     '请把它压缩成一份供**同一个智能体继续工作**的进度摘要，用中文、分点、不超过 1500 字。\\n'\r\n35:     '必须保留：\\n'\r\n36:     '1. 已完成与未完成的需求（带需求 ID）及其状态；\\n'\r\n37:     '2. 已创建 / 修改的文件路径及各自作用，关键设计（数据模型、API 路由、字段名、页面路由、关键文案）；\\n'\r\n38:     '3. 已发现的问题、报错及其解决办法（避免重蹈覆辙）；\\n'\r\n39:     '4. 当前正在做什么、下一步该做什么；运行环境事实（端口、启动方式、账号等）。\\n'\r\n40:     '不要复述文件全文，不要编造记录里没有的内容；如果材料里有「先前摘要」，把它和新记录合并成一份。'\r\n41: )\r\n42: \r\n43: SUMMARY_HEADER = (\r\n44:     '【系统提示：为控制上下文长度，较早的对话已压缩成下面的进度摘要】\\n'\r\n45:     '文件内容与命令输出等细节已省略——磁盘上的文件就是最新状态，需要细节请重新读取；'\r\n46:     '不要重复已完成的步骤。待办进度以 todo(action=\"list\") 为准。\\n\\n'\r\n47: )\r\n48: \r\n49: \r\n50: # ── 基础工具 ────────────────────────────────────────────────────────\r\n51: \r\n52: def _size(message: dict) -> int:\r\n\r\nFILE context_compaction.py\r\n186: def _model_summary(model: str, previous: str | None, messages: list[dict]) -> str:\r\n187:     from client import summarize_text  # 延迟导入：避免与 client 循环依赖\r\n188: \r\n189:     parts = []\r\n190:     if previous:\r\n191:         parts.append('【先前摘要】\\n' + previous[:SUMMARY_MAX_CHARS * 2])\r\n192:     parts.append('【新的工作记录】\\n' + _transcript(messages))\r\n193:     text = summarize_text(model, SUMMARY_SYSTEM, '\\n\\n'.join(parts))\r\n194:     return text[:SUMMARY_MAX_CHARS]\r\n195: \r\n196: \r\n197: # ── 压缩边界与视图 ──────────────────────────────────────────────────\r\n198: \r\n199: def _plan(seq, messages: list[dict]) -> tuple[int, int] | None:\r\n200:     \"\"\"需要压缩时返回（旧边界, 新边界），否则 None。\"\"\"\r\n201:     head = _head_end(messages)\r\n202:     upto = max(getattr(seq, '_compact_upto', 0), head)\r\n203:     if upto > len(messages):  # 历史被重置过\r\n204:         upto = head\r\n205:     if sum(_size(m) for m in messages[upto:]) <= HISTORY_LIMIT_CHARS:\r\n206:         return None\r\n207:     groups = _groups(messages, upto)\r\n208:     kept, keep_from = 0, len(groups)\r\n209:     for k in range(len(groups) - 1, -1, -1):\r\n210:         kept += sum(_size(m) for m in messages[groups[k][0]:groups[k][1]])\r\n211:         keep_from = k\r\n212:         if kept > KEEP_RECENT_CHARS and len(groups) - k >= MIN_KEEP_GROUPS:\r\n213:             break\r\n214:     if keep_from >= len(groups) or groups[keep_from][0] <= upto:\r\n215:         return None\r\n216:     return upto, groups[keep_from][0]\r\n217: \r\n218: \r\n219: def maybe_compact(seq, model: str | None) -> bool:\r\n220:     \"\"\"引擎在每个模型轮开始前调用：超限就压缩一次并把摘要存进 seq。返回是否发生了压缩。\"\"\"\r\n221:     messages = seq.to_list()\r\n222:     plan = _plan(seq, messages)\r\n223:     if plan is None:\r\n224:         return False\r\n225:     old_upto, new_upto = plan\r\n226:     head = _head_end(messages)\r\n227:     previous = getattr(seq, '_compact_summary', None)\r\n228:     dropped = messages[max(old_upto, head):new_upto]\r\n229: \r\n230:     how = '模型总结'\r\n231:     try:\r\n232:         if not model:\r\n233:             raise RuntimeError('没有可用于总结的模型')\r\n234:         summary = _model_summary(model, previous, dropped)\r\n235:     except Exception as exc:  # noqa: BLE001 —— 任何失败都降级，压缩不能拖垮主流程\r\n236:         how = f'机械摘要（模型总结失败：{_one_line(exc, 80)}）'\r\n237:         summary = (previous + '\\n' if previous else '') + _digest(dropped)\r\n238:         summary = summary[-DIGEST_MAX_CHARS:]\r\n239: \r\n240:     seq._compact_summary = summary\r\n241:     seq._compact_upto = new_upto\r\n242:     print(\r\n243:         f'\\n[压缩] 上下文超限，较早的 {new_upto - head} 条消息已压缩为摘要'\r\n244:         f'（本次新增 {len(dropped)} 条，{how}，摘要 {len(summary)} 字）',\r\n245:         flush=True,\r\n246:     )\r\n247:     return True\r\n248: \r\n249: \r\n250: def compact_history(seq, messages: list[dict]) -> list[dict]:\r\n251:     \"\"\"发给模型的消息视图：套用 seq 上已存的压缩边界与摘要（纯函数，不发请求）。\"\"\"\r\n252:     head = _head_end(messages)\r\n253:     upto = getattr(seq, '_compact_upto', 0)\r\n254:     if upto > len(messages):\r\n255:         upto = 0\r\n256:     if upto <= head:\r\n257:         return messages\r\n258:     summary = getattr(seq, '_compact_summary', None) or _digest(messages[head:upto])\r\n259:     return messages[:head] + [{'role': 'user', 'content': SUMMARY_HEADER + summary}] + messages[upto:]\r\n\r\nFILE delivery_guard.py\r\n75: def check_structure(root: Path) -> None:\r\n76:     for rel in ('frontend/package.json', 'backend/package.json', 'frontend/dist/index.html'):\r\n77:         if not (root / rel).exists():\r\n78:             _log(f'警告：缺少 {rel}')\r\n79:     try:\r\n80:         scripts = json.loads((root / 'backend/package.json').read_text(encoding='utf-8')).get('scripts') or {}\r\n81:         if 'start' not in scripts:\r\n82:             _log('警告：backend/package.json 没有 scripts.start')\r\n83:     except (OSError, ValueError):\r\n84:         pass\r\n85: \r\n86: \r\n87: def smoke(root: Path, port: int) -> None:\r\n88:     backend = root / 'backend'\r\n89:     if not (backend / 'package.json').exists() or not (backend / 'node_modules').exists():\r\n90:         _log('跳过冒烟：backend 未安装依赖或不存在')\r\n91:         return\r\n92:     env = {**os.environ, 'PORT': str(port)}\r\n93:     try:\r\n94:         proc = subprocess.Popen(\r\n95:             [shutil.which('npm') or 'npm', 'run', 'start'], cwd=backend, env=env,\r\n96:             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\r\n97:             start_new_session=(os.name == 'posix'),\r\n98:         )\r\n99:     except OSError as exc:\r\n100:         _log(f'冒烟未能启动：{exc}')\r\n101:         return\r\n102:     try:\r\n103:         deadline = time.monotonic() + SMOKE_WAIT_SECONDS\r\n104:         home = '-'\r\n105:         while time.monotonic() < deadline and proc.poll() is None:\r\n106:             home = _fetch(f'http://127.0.0.1:{port}/')\r\n107:             if home.isdigit():\r\n108:                 break\r\n109:             time.sleep(1)\r\n110:         if proc.poll() is not None:\r\n111:             _log(f'冒烟失败：`npm run start` 提前退出（exit={proc.returncode}）')\r\n112:             return\r\n113:         health = _fetch(f'http://127.0.0.1:{port}/api/health')\r\n114:         _log(f'冒烟结果：GET / -> {home}；GET /api/health -> {health}')\r\n115:         for host in ('localhost', '[::1]'):\r\n116:             code = _fetch(f'http://{host}:{port}/')\r\n117:             _log(f'  经 {host} 访问 -> {code}' + ('' if code.isdigit() else '（评测若用该地址会连接失败）'))\r\n118:     finally:\r\n119:         if os